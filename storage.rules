rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Proje görselleri ve videosu — herkese açık okuma, yazma yok.
    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Panelden yüklenen görseller (blog kapakları, kampanya broşürleri, galeri).
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|avif|svg\\+xml)');
      allow delete: if isAdmin();
    }

    // Panelden yüklenen belgeler (ruhsat, iskân, imar planı, tapu).
    match /belgeler/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
