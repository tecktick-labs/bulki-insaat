rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Proje görselleri ve videosu herkese açık okunur; yazma yalnızca konsol/Admin SDK üzerinden.
    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
