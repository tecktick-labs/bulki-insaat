rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /projectData/{documentId} {
      allow read: if documentId == 'website' || documentId == 'panel-access';

      allow create, update: if documentId == 'panel-access'
        && request.resource.data.keys().hasOnly(['codeHash'])
        && request.resource.data.codeHash == '1f01eeaf275dc3ebe336ba85d69d28ee3b62a828e146642fdf6c4908b19bbfbb';

      allow create, update: if documentId == 'website'
        && request.resource.data.keys().hasAll([
          'general',
          'hero',
          'apartmentTypes',
          'location',
          'blocks',
          'contacts',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'general',
          'hero',
          'apartmentTypes',
          'location',
          'blocks',
          'contacts',
          'updatedAt'
        ]);

      allow update, delete: if false;
    }
  }
}
