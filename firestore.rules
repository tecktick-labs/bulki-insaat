rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Yönetici listesi. Her yetkili için admins/{uid} dokümanı elle oluşturulur.
    // Kimse istemciden okuyamaz veya yazamaz; sadece Admin SDK erişir.
    match /admins/{uid} {
      allow read, write: if false;
    }

    match /projectData/website {
      // Site içeriği herkese açık okunur.
      allow read: if true;

      // Yazma yalnızca admins koleksiyonunda kaydı olan, giriş yapmış kullanıcılara açık.
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && request.resource.data.keys().hasAll(['general', 'hero', 'location', 'blocks', 'contacts', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['general', 'hero', 'location', 'blocks', 'contacts', 'updatedAt']);
    }

    // Diğer her şey kapalı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
